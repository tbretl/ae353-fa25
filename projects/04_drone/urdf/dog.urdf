<?xml version="1.0" ?>
<robot name="dog">

  <material name = "dark-yellow">
    <color rgba = "1 0.8196078431 0.1450980392 1" />
  </material>

  <link name="base" concave="yes">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="dog.stl" scale="1 1 1"/>
      </geometry>
      <material name="dark-yellow"/>
    </visual>
    <collision concave="yes">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="dog.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

</robot>
